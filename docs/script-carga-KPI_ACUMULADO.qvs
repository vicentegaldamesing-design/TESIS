// =============================================================================
// Carga de histórico de KPIs Acumulados
// Archivo: KPI_ACUMULADO.xlsx  (hoja: Sheet1)
// Columnas esperadas:
// Anio, Semana, FechaSnapshot, FechaInicio, FechaCierre, Planta,
// KPI_ID, Ciclo, Elemento, Indicador, Num, Den, Pct, Fuente, TsCarga
// =============================================================================
// IMPORTANTE:
// Se renombran campos con prefijo Acum_ para NO mezclarse con
// Semana / Planta / fechas ya existentes en tu app.
// =============================================================================

SET ThousandSep='.';
SET DecimalSep=',';
SET DateFormat='DD-MM-YYYY';
SET TimestampFormat='DD-MM-YYYY hh:mm:ss';

KPI_ACUMULADO:
LOAD
    Anio                                              as Acum_Anio,
    Semana                                            as Acum_Semana,
    Date(Date#(FechaSnapshot, 'DD-MM-YYYY'))          as Acum_FechaSnapshot,
    Date(Date#(FechaInicio, 'DD-MM-YYYY'))            as Acum_FechaInicio,
    Date(Date#(FechaCierre, 'DD-MM-YYYY'))            as Acum_FechaCierre,
    Planta                                            as Acum_Planta,
    KPI_ID                                            as KPI_ID,
    Ciclo                                             as Acum_Ciclo,
    Elemento                                          as Acum_Elemento,
    Indicador                                         as Acum_Indicador,
    Num#(Num, '#.')                                   as Num,
    Num#(Den, '#.')                                   as Den,
    If(Len(Trim(Text(Pct))) = 0 or IsNull(Pct),
        If(Num#(Den, '#.') = 0, Null(), Num#(Num, '#.') / Num#(Den, '#.')),
        Num#(Pct, '#.####')
    )                                                 as Pct,
    Fuente                                            as Acum_Fuente,
    Timestamp(Timestamp#(TsCarga, 'DD-MM-YYYY hh:mm:ss')) as Acum_TsCarga,
    Anio & '|' & Semana & '|' & Planta & '|' & KPI_ID as ClaveSnapshot,
    Num#(Num, '#.') & '/' & Num#(Den, '#.')           as Fraccion,
    Dual('Semana ' & Semana, Semana)                  as Acum_SemanaLabel
FROM [lib://DataFiles/KPI_ACUMULADO.xlsx]
(ooxml, embedded labels, table is Sheet1);

// =============================================================================
// Expresiones sugeridas en el front (cuando conectes los KPIs grises):
//
// Fracción:
//   Sum({<KPI_ID={'2.2_KPI_Avance_Doc'}>} Num)
//   & '/' &
//   Sum({<KPI_ID={'2.2_KPI_Avance_Doc'}>} Den)
//
// Porcentaje:
//   Sum({<KPI_ID={'2.2_KPI_Avance_Doc'}>} Num)
//   /
//   Sum({<KPI_ID={'2.2_KPI_Avance_Doc'}>} Den)
//
// Filtros del histórico:
//   Acum_Semana , Acum_Anio , Acum_Planta
// =============================================================================
